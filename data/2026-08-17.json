   "theme": "地緣政治（中東與戰事）",
   "title": "能源股把停火整個月的漲幅擠在最後五天",
   "subtitle": "能源類股 ETF（XLE）與標普 500，2026-07-17＝100，至 2026-08-14",
   "kind": "timeseries",
   "y_label": "指數（2026-07-17＝100）",
   "y_fmt": "{:,.1f}",
   "source": "資料來源：Tiingo（XLE）、FRED SP500，2026-07-17 至 2026-08-14",
   "note": "XLE 是能源類股 ETF，不是油價本身。",
   "series_spec": [
    {
     "id": "XLE",
     "name": "能源類股 ETF（XLE）",
     "t": "rebase",
     "since": "2026-07-17"
